rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaffOrAdmin() {
      return isSignedIn() && (
        getUserData().role == 'STAFF' || 
        getUserData().role == 'ADMIN' || 
        getUserData().role == 'staff' || 
        getUserData().role == 'admin'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'ADMIN' || 
        getUserData().role == 'admin'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isStaffOrAdmin();
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Staff/admin can update anything. Customers can update to CANCELLED if original order status was PENDING
      allow update: if isStaffOrAdmin() || (
        isSignedIn() && (
          request.resource.data.status == 'CANCELLED' || request.resource.data.status == 'cancelled'
        ) && (
          resource.data.status == 'PENDING' || resource.data.status == 'pending'
        )
      ) || (
        // Customer marking QR as pending_confirm
        isSignedIn() && request.resource.data.payment.status == 'pending_confirm'
      );
    }

    match /transactions/{txId} {
      // Customer reads own transaction, Staff/Admin reads all
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        string(resource.data.userId) == string(getUserData().id) || 
        isStaffOrAdmin()
      );
      // Customer creates own deposit/payment transaction, Staff/Admin creates any
      allow create: if isSignedIn() && (
        (request.resource.data.type == "deposit" && (request.resource.data.userId == request.auth.uid || string(request.resource.data.userId) == string(getUserData().id))) ||
        isStaffOrAdmin()
      );
      // Staff/Admin updates when confirming/rejecting. Customer CANNOT modify after creation.
      allow update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }
    
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
